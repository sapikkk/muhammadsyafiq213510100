# Salin ke .env. Jangan isi rahasia di file contoh ini.
# Prisma CLI membaca .env. Koneksi pooled butuh DIRECT_URL ke host langsung.

# PostgreSQL. URL sungguhan hanya di .env.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kokonus_farm"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/kokonus_farm"

# NextAuth (US1.4). Buat nilai acak sendiri, jangan tempel token di chat.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
