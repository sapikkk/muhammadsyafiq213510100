# Salin ke .env. Jangan isi rahasia di file contoh ini.
# Prisma CLI membaca .env. Koneksi pooled butuh DIRECT_URL ke host langsung.

# PostgreSQL. URL sungguhan hanya di .env.
# Remote dev (FINDING-01): tambah ?pool_timeout=30&connection_limit=5 — lihat docs/deployment/FINDING-01-db-pool.md
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kokonus_farm"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/kokonus_farm"

# NextAuth (US1.4). Buat nilai acak sendiri, jangan tempel token di chat.
# NEXTAUTH_URL harus sama dengan port dev (3000). Ganti jika pakai port lain.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Dev-only: lewati cek peran route/API saat audit UI (jangan true di repo/CI/Vercel).
AUDIT_BYPASS_RBAC=false

# Production (Vercel): gunakan DATABASE_URL pooled + DIRECT_URL dari provider.
# Serverless: pertimbangkan connection_limit=1 pada DATABASE_URL (lihat docs/deployment/vercel-go-live.md).
