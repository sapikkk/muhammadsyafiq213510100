# Salin ke .env. Jangan isi rahasia di file contoh ini.
# Prisma CLI membaca .env. Koneksi pooled butuh DIRECT_URL ke host langsung.

# PostgreSQL. URL sungguhan hanya di .env.
# Dev: isi DATABASE_URL/DIRECT_URL dari provider cloud (Prisma/Neon/dll.) + pool_timeout — docs/deployment/dev-postgres-lokal.md
# Remote dev (FINDING-01): ?sslmode=require&pool_timeout=60&connection_limit=10&connect_timeout=8 — docs/deployment/dev-postgres-lokal.md
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kokonus_farm"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/kokonus_farm"

# NextAuth (US1.4). Buat nilai acak sendiri, jangan tempel token di chat.
# NEXTAUTH_URL harus sama dengan port dev (3000). Ganti jika pakai port lain.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Dev-only: lewati cek peran route/API saat audit UI (jangan true di repo/CI/Vercel).
AUDIT_BYPASS_RBAC=false

# Pre-launch staging (Vercel): semua role boleh akses /owner|/admin|/petani. Matikan sebelum go-live.
# KOKONUS_PRELAUNCH_RBAC=false

# Seed demo (npm run seed:demo-lengkap): sandi akun demo; default "1" jika kosong.
# SEED_DEMO_PASSWORD="1"

# Opsional — seed fondasi (npm run seed / db:reset): satu Owner pertama
# SEED_OWNER_NAMA="Nama Owner"
# SEED_OWNER_EMAIL="owner@contoh.local"
# SEED_OWNER_PASSWORD="ganti-sandi-kuat-min-8"

# Cuaca beranda (Open-Meteo). Koordinat kebun — opsional.
# WEATHER_LAT="-6.200000"
# WEATHER_LON="106.816666"
# WEATHER_LABEL="Kebun Kokonus"

# Production (Vercel): gunakan DATABASE_URL pooled + DIRECT_URL dari provider.
# Serverless: pertimbangkan connection_limit=1 pada DATABASE_URL (lihat docs/deployment/panduan-deploy-vercel-postgres.md).
