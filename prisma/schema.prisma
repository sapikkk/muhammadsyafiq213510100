// Satuan masih terbuka: masa_sewa, umur_ekonomis, berat panen, dasar harga curah, bunga_persen. PRD 8.1.
// ponytail: tanggal dan jumlah panen wajib. Jadikan nullable saat US3.1 butuh baris siklus yang belum panen.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Lahan {
  id                   Int          @id @default(autoincrement())
  nilai_sewa           Decimal      @db.Decimal(18, 2)
  masa_sewa            Int
  amortisasi_per_bulan Decimal      @db.Decimal(18, 2)
  greenhouse           Greenhouse[]
}

model Greenhouse {
  id                   Int     @id @default(autoincrement())
  lahan_id             Int
  lahan                Lahan   @relation(fields: [lahan_id], references: [id])
  nama                 String  @db.VarChar(100)
  nilai_investasi      Decimal @db.Decimal(18, 2)
  umur_ekonomis        Int
  depresiasi_per_bulan Decimal @db.Decimal(18, 2)
  kolam                Kolam[]
}

model Kolam {
  id               Int               @id @default(autoincrement())
  greenhouse_id    Int
  greenhouse       Greenhouse        @relation(fields: [greenhouse_id], references: [id])
  nama             String            @db.VarChar(100)
  kapasitas_lubang Int
  status           String            @db.VarChar(30)
  siklus           Siklus_Produksi[]
}

model Varietas {
  id                    Int               @id @default(autoincrement())
  nama                  String            @db.VarChar(100)
  harga_benih_per_gram  Decimal           @db.Decimal(18, 2)
  biji_per_gram         Decimal           @db.Decimal(10, 2)
  daya_kecambah         Decimal           @db.Decimal(5, 2)
  lama_semai            Int
  lama_di_kolam         Int
  berat_rata_rata_panen Decimal           @db.Decimal(12, 3)
  berat_per_pack        Decimal           @db.Decimal(12, 3)
  harga_jual_curah      Decimal           @db.Decimal(18, 2)
  harga_jual_pack       Decimal           @db.Decimal(18, 2)
  status                String            @db.VarChar(30)
  siklus                Siklus_Produksi[]
}

model Siklus_Produksi {
  id                   Int             @id @default(autoincrement())
  kode_batch           String          @unique @db.VarChar(40)
  varietas_id          Int
  varietas             Varietas        @relation(fields: [varietas_id], references: [id])
  kolam_id             Int
  kolam                Kolam           @relation(fields: [kolam_id], references: [id])
  tanggal_semai        DateTime        @db.Date
  tanggal_pindah_kolam DateTime?       @db.Date
  tanggal_panen        DateTime?       @db.Date
  jumlah_disemai       Int
  jumlah_layak_jual    Int             @default(0)
  total_susut          Int             @default(0)
  status               String          @db.VarChar(30)
  biaya_langsung       Biaya_Langsung?
  log_kegagalan        Log_Kegagalan[]
  hpp                  HPP?
  penjualan            Penjualan[]
  logProduksi          Log_Produksi[]
  laporanPanen         Laporan_Panen?
}

// Jejak pindah fase (ProductionLog, US3.2).
model Log_Produksi {
  id         Int             @id @default(autoincrement())
  siklus_id  Int
  siklus     Siklus_Produksi @relation(fields: [siklus_id], references: [id], onDelete: Cascade)
  fase_dari  String          @db.VarChar(30)
  fase_ke    String          @db.VarChar(30)
  catatan    String?         @db.VarChar(255)
  userId     Int
  user       User            @relation(fields: [userId], references: [id])
  waktu      DateTime        @default(now())
}

// US3.3 — harvest report (satu per siklus, menunggu approval Admin).
model Laporan_Panen {
  id                     Int             @id @default(autoincrement())
  siklus_id              Int             @unique
  siklus                 Siklus_Produksi @relation(fields: [siklus_id], references: [id], onDelete: Cascade)
  berat_layak_gram       Decimal         @db.Decimal(12, 3)
  berat_tidak_layak_gram Decimal         @db.Decimal(12, 3)
  jumlah_layak           Int
  jumlah_tidak_layak     Int
  status                 String          @db.VarChar(30)
  catatan                String?         @db.VarChar(500)
  userId                 Int
  user                   User            @relation(fields: [userId], references: [id])
  waktu_kirim            DateTime        @default(now())
}

model Biaya_Langsung {
  id                  Int             @id @default(autoincrement())
  siklus_id           Int             @unique
  siklus              Siklus_Produksi @relation(fields: [siklus_id], references: [id])
  biaya_benih         Decimal         @db.Decimal(18, 2)
  biaya_rockwool      Decimal         @db.Decimal(18, 2)
  biaya_nutrisi       Decimal         @db.Decimal(18, 2)
  biaya_listrik_pompa Decimal         @db.Decimal(18, 2)
  subtotal            Decimal         @db.Decimal(18, 2)
}

model Petani {
  id           Int     @id @default(autoincrement())
  nama         String  @db.VarChar(100)
  gaji_bulanan Decimal @db.Decimal(18, 2)
}

model Biaya_Overhead {
  id                    Int      @id @default(autoincrement())
  periode               DateTime @db.Date
  depresiasi_greenhouse Decimal  @db.Decimal(18, 2)
  depresiasi_listrik    Decimal  @db.Decimal(18, 2)
  sewa_lahan            Decimal  @db.Decimal(18, 2)
  gaji_karyawan         Decimal  @db.Decimal(18, 2)
  subtotal              Decimal  @db.Decimal(18, 2)
}

model Log_Kegagalan {
  id             Int             @id @default(autoincrement())
  siklus_id      Int
  siklus         Siklus_Produksi @relation(fields: [siklus_id], references: [id])
  tahap          String          @db.VarChar(50)
  jumlah_gagal   Int
  hari_hidup     Int
  penyebab       String          @db.Text
  kategori_susut String          @db.VarChar(50)
  jenis_kerugian String          @db.VarChar(50)
  biaya_kerugian Decimal         @db.Decimal(18, 2)
}

model HPP {
  id                    Int             @id @default(autoincrement())
  siklus_id             Int             @unique
  siklus                Siklus_Produksi @relation(fields: [siklus_id], references: [id])
  biaya_langsung_total  Decimal         @db.Decimal(18, 2)
  overhead_teralokasi   Decimal         @db.Decimal(18, 2)
  biaya_plastik_packing Decimal         @db.Decimal(18, 2)
  total_biaya           Decimal         @db.Decimal(18, 2)
  hpp_per_lubang        Decimal         @db.Decimal(18, 2)
  hpp_per_kg            Decimal         @db.Decimal(18, 2)
  hpp_per_pack          Decimal         @db.Decimal(18, 2)
}

model Penjualan {
  id               Int             @id @default(autoincrement())
  siklus_id        Int
  siklus           Siklus_Produksi @relation(fields: [siklus_id], references: [id])
  pelanggan_id     Int
  pelanggan        Pelanggan       @relation(fields: [pelanggan_id], references: [id])
  jenis            String          @db.VarChar(30)
  jumlah           Decimal         @db.Decimal(12, 3)
  harga_satuan     Decimal         @db.Decimal(18, 2)
  total_pendapatan Decimal         @db.Decimal(18, 2)
}

model Pelanggan {
  id         Int         @id @default(autoincrement())
  nama       String      @db.VarChar(100)
  alamat     String      @db.Text
  no_telepon String      @db.VarChar(25)
  email      String      @db.VarChar(254)
  penjualan  Penjualan[]
}

model Laporan_LabaRugi {
  id                    Int      @id @default(autoincrement())
  periode               DateTime @db.Date
  pendapatan            Decimal  @db.Decimal(18, 2)
  hpp                   Decimal  @db.Decimal(18, 2)
  laba_kotor            Decimal  @db.Decimal(18, 2)
  kerugian_operasional  Decimal  @db.Decimal(18, 2)
  beban_penjualan       Decimal  @db.Decimal(18, 2)
  beban_ops_nonproduksi Decimal  @db.Decimal(18, 2)
  laba_usaha_ebit       Decimal  @db.Decimal(18, 2)
  beban_bunga           Decimal  @db.Decimal(18, 2)
  laba_rugi_bersih      Decimal  @db.Decimal(18, 2)
}

model Neraca {
  id               Int      @id @default(autoincrement())
  periode          DateTime @db.Date
  total_aset       Decimal  @db.Decimal(18, 2)
  total_liabilitas Decimal  @db.Decimal(18, 2)
  total_ekuitas    Decimal  @db.Decimal(18, 2)
}

model Pinjaman_Modal {
  id                    Int     @id @default(autoincrement())
  pokok                 Decimal @db.Decimal(18, 2)
  bunga_persen          Decimal @db.Decimal(7, 4)
  tenor                 Int
  sisa_pokok            Decimal @db.Decimal(18, 2)
  cicilan_per_bulan     Decimal @db.Decimal(18, 2)
  beban_bunga_per_bulan Decimal @db.Decimal(18, 2)
}

// Akun login. Bukan entitas Petani di ERD.
enum Role {
  OWNER
  ADMIN
  PEKERJA
}

model User {
  id                 Int                    @id @default(autoincrement())
  nama               String                 @db.VarChar(100)
  email              String                 @unique @db.VarChar(254)
  passwordHash       String                 @db.VarChar(100)
  role               Role
  mustChangePassword Boolean                @default(false)
  resetRequests      PasswordResetRequest[] @relation("requester")
  handledResets      PasswordResetRequest[] @relation("handler")
  jurnalDibuat       Jurnal[]               @relation("jurnalPembuat")
  jurnalDiputus      Jurnal[]               @relation("jurnalPemutus")
  pergerakanInventaris PergerakanInventaris[]
  activePackDibuat     ActivePack[]
  logProduksi          Log_Produksi[]
  laporanPanen         Laporan_Panen[]
}

// Epic 4 — inventaris bahan. Tidak ada di ERD Figma 16 tabel, ditambah untuk US4.1.
enum SatuanInventaris {
  GRAM
  KG
  PCS
  PACK
  LITER
}

enum TipePergerakan {
  IN
  OUT
  ADJUST
}

model ItemInventaris {
  id          Int                    @id @default(autoincrement())
  kode        String                 @unique @db.VarChar(30)
  nama        String                 @db.VarChar(100)
  satuan      SatuanInventaris
  stokSaatIni Decimal                @default(0) @db.Decimal(12, 3)
  stokMinimum Decimal                @default(0) @db.Decimal(12, 3)
  aktif       Boolean                @default(true)
  pergerakan  PergerakanInventaris[]
  activePack  ActivePack[]
}

enum StatusActivePack {
  AKTIF
  HABIS
}

// US4.2 — pack aktif untuk alokasi biaya per unit (F15).
model ActivePack {
  id           Int              @id @default(autoincrement())
  kode         String           @unique @db.VarChar(30)
  itemId       Int
  item         ItemInventaris   @relation(fields: [itemId], references: [id])
  hargaPack    Decimal          @db.Decimal(18, 2)
  jumlahUnit   Decimal          @db.Decimal(12, 3)
  sisaUnit     Decimal          @db.Decimal(12, 3)
  biayaPerUnit Decimal          @db.Decimal(18, 4)
  status       StatusActivePack @default(AKTIF)
  keterangan   String?          @db.VarChar(255)
  dibuatOlehId Int
  dibuatOleh   User             @relation(fields: [dibuatOlehId], references: [id])
  dibuatPada   DateTime         @default(now())
}

model PergerakanInventaris {
  id          Int              @id @default(autoincrement())
  itemId      Int
  item        ItemInventaris   @relation(fields: [itemId], references: [id])
  tipe        TipePergerakan
  jumlah      Decimal          @db.Decimal(12, 3)
  stokSebelum Decimal          @db.Decimal(12, 3)
  stokSesudah Decimal          @db.Decimal(12, 3)
  keterangan  String?          @db.VarChar(255)
  userId      Int
  user        User             @relation(fields: [userId], references: [id])
  dibuatPada  DateTime         @default(now())
}

enum ResetStatus {
  PENDING
  APPROVED
  REJECTED
}

// Satu baris per permintaan lupa sandi. Jadi jejak siapa menyetujui dan kapan.
model PasswordResetRequest {
  id          Int         @id @default(autoincrement())
  userId      Int
  user        User        @relation("requester", fields: [userId], references: [id])
  status      ResetStatus @default(PENDING)
  requestedAt DateTime    @default(now())
  handledById Int?
  handledBy   User?       @relation("handler", fields: [handledById], references: [id])
  handledAt   DateTime?
}

// Bagan akun (COA). Tidak ada di ERD Figma, ditambah untuk Epic 2 sesuai PRD US2.1.
enum TipeAkun {
  ASET
  KEWAJIBAN
  MODAL
  PENDAPATAN
  BEBAN
}

model Akun {
  id       Int           @id @default(autoincrement())
  kode     String        @unique @db.VarChar(20)
  nama     String        @db.VarChar(100)
  tipe     TipeAkun
  parentId Int?
  parent   Akun?         @relation("AkunInduk", fields: [parentId], references: [id])
  anak     Akun[]        @relation("AkunInduk")
  aktif    Boolean       @default(true)
  // Saldo normal: Aset dan Beban bertambah di debit, lainnya di kredit. Hanya berubah saat jurnal APPROVED.
  saldo    Decimal       @default(0) @db.Decimal(18, 2)
  baris    JurnalBaris[]
}

enum StatusJurnal {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

model Jurnal {
  id            Int           @id @default(autoincrement())
  tanggal       DateTime      @db.Date
  keterangan    String        @db.VarChar(255)
  status        StatusJurnal  @default(DRAFT)
  dibuatOlehId  Int
  dibuatOleh    User          @relation("jurnalPembuat", fields: [dibuatOlehId], references: [id])
  dibuatPada    DateTime      @default(now())
  diputusOlehId Int?
  diputusOleh   User?         @relation("jurnalPemutus", fields: [diputusOlehId], references: [id])
  diputusPada   DateTime?
  alasanTolak   String?       @db.Text
  baris         JurnalBaris[]
}

model JurnalBaris {
  id       Int     @id @default(autoincrement())
  jurnalId Int
  jurnal   Jurnal  @relation(fields: [jurnalId], references: [id], onDelete: Cascade)
  akunId   Int
  akun     Akun    @relation(fields: [akunId], references: [id])
  debit    Decimal @default(0) @db.Decimal(18, 2)
  kredit   Decimal @default(0) @db.Decimal(18, 2)
}

model Arus_Kas {
  id                   Int      @id @default(autoincrement())
  periode              DateTime @db.Date
  kas_operasi          Decimal  @db.Decimal(18, 2)
  kas_investasi        Decimal  @db.Decimal(18, 2)
  kas_pendanaan        Decimal  @db.Decimal(18, 2)
  perubahan_kas_bersih Decimal  @db.Decimal(18, 2)
}
